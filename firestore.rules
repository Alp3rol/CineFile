rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Authorship guards (shared by `logs`, `posts`, their comments, and
    // `shared_collections`).
    //
    // All of these denormalise the author's display name and avatar onto the
    // document so a feed render costs no `users` lookup. Only `userId` used to
    // be checked, which left the two *displayed* fields as free text: anyone
    // could publish a post carrying somebody else's username and avatar, and
    // the feed had no way to tell. These functions pin both to the caller's
    // own profile document.
    //
    // `.get(field, default)` is used throughout this file because documents
    // written before a field existed simply don't have it.
    // ---------------------------------------------------------------------

    function ownProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function authorFieldsAreOwn() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.get('username', '') == ownProfile().get('username', '')
        && request.resource.data.get('userAvatarUrl', '') == ownProfile().get('avatarUrl', '');
    }

    // Avatars are rendered with a plain network image on every feed row, so an
    // arbitrary URL here would make each viewer's device call out to a host of
    // the author's choosing — handing them the IP and User-Agent of everyone
    // who scrolled past. The app only ever offers the generated DiceBear set,
    // so the allowlist costs nothing and closes that.
    function isAllowedAvatar(url) {
      return url is string
        && url.size() <= 300
        && (url.matches('https://api[.]dicebear[.]com/.*')
         || url.matches('https://firebasestorage[.]googleapis[.]com/.*'));
    }

    // Social counters describe how *other* people reacted, so a brand-new
    // document must start neutral. Without this, a post could be created with
    // starredBy already stuffed full of uids that never liked it (and
    // commentCount set to anything at all) — isOwnStarToggle/isCommentCountStep
    // below only constrain UPDATES, so the create was the way around them.
    function socialCountersStartEmpty() {
      return request.resource.data.get('starredBy', []) == []
        && request.resource.data.get('commentCount', 0) == 0;
    }

    // Free-text fields are capped so a single document can't be inflated
    // toward Firestore's 1 MB limit, which costs storage and breaks the feed
    // layout for everyone who loads it.
    function optionalTextWithin(value, limit) {
      return value == null || (value is string && value.size() <= limit);
    }

    function withinTextLimits() {
      return optionalTextWithin(request.resource.data.get('caption', null), 500)
        && optionalTextWithin(request.resource.data.get('notes', null), 2000)
        && optionalTextWithin(request.resource.data.get('watchPlace', null), 100)
        && optionalTextWithin(request.resource.data.get('watchCompanion', null), 100)
        && optionalTextWithin(request.resource.data.get('tags', null), 200);
    }

    // Author identity and social proof are established independently from an
    // owner's editable post/log body. Once created, an owner may change their
    // caption, notes, visibility, rating, etc. but may not transfer authorship
    // or manufacture reactions by taking the broad owner-update branch.
    function authorAndSocialFieldsAreUnchanged() {
      return request.resource.data.get('userId', '') == resource.data.get('userId', '')
        && request.resource.data.get('username', '') == resource.data.get('username', '')
        && request.resource.data.get('userAvatarUrl', '') == resource.data.get('userAvatarUrl', '')
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('starredBy', []) == resource.data.get('starredBy', [])
        && request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0);
    }

    // ---------------------------------------------------------------------
    // Social-interaction write guards (shared by `logs` and `posts`).
    //
    // Both collections let *other* users touch two fields — starredBy (like)
    // and commentCount — on a document they don't own. Restricting which KEYS
    // may change (hasOnly) is not enough on its own: it still let anyone
    // replace the whole starredBy array (wiping every other user's like, or
    // stuffing it with uids that never liked anything) or set commentCount to
    // an arbitrary number. These functions pin down the allowed *shape* of the
    // change, not just its field names.
    // ---------------------------------------------------------------------

    // A like toggle may only add or remove the caller's own uid: the symmetric
    // difference between the old and new arrays must contain nothing else.
    function isOwnStarToggle() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starredBy'])
        && request.resource.data.get('starredBy', []).toSet()
             .difference(resource.data.get('starredBy', []).toSet())
             .hasOnly([request.auth.uid])
        && resource.data.get('starredBy', []).toSet()
             .difference(request.resource.data.get('starredBy', []).toSet())
             .hasOnly([request.auth.uid]);
    }

    function parentDocument(collectionName, parentId) {
      return /databases/$(database)/documents/$(collectionName)/$(parentId);
    }

    function commentDocument(collectionName, parentId, commentId) {
      return /databases/$(database)/documents/$(collectionName)/$(parentId)/comments/$(commentId);
    }

    // A counter step is valid only when the comment named by the mutation
    // marker is created/deleted in the same atomic request. Checking both the
    // state before and after closes the old loophole where any signed-in user
    // could issue repeated +1 updates without writing a comment at all.
    function isCommentCountStep(collectionName, parentId) {
      let commentId = request.resource.data.get('lastCommentMutationId', '');
      let delta = request.resource.data.get('commentCount', 0)
        - resource.data.get('commentCount', 0);
      return commentId is string
        && commentId.size() > 0
        && request.resource.data.get('commentCount', 0) >= 0
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['commentCount', 'lastCommentMutationId'])
        && (
          (delta == 1
            && !exists(commentDocument(collectionName, parentId, commentId))
            && existsAfter(commentDocument(collectionName, parentId, commentId)))
          ||
          (delta == -1
            && exists(commentDocument(collectionName, parentId, commentId))
            && !existsAfter(commentDocument(collectionName, parentId, commentId)))
        );
    }

    function parentCounterMatchesComment(collectionName, parentId, commentId, delta) {
      return getAfter(parentDocument(collectionName, parentId)).data.get('commentCount', 0)
            == get(parentDocument(collectionName, parentId)).data.get('commentCount', 0) + delta
        && getAfter(parentDocument(collectionName, parentId)).data.get('lastCommentMutationId', '')
            == commentId;
    }

    // Following someone touches the *other* user's followerCount. Same
    // reasoning as isCommentCountStep: allow the counter to move by one, not
    // to be set to whatever the caller likes.
    function followEdge(followerId, followingId) {
      return /databases/$(database)/documents/follows/$(followerId + '_' + followingId);
    }

    function userProfile(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function edgeTransitionMatches(delta, followerId, followingId) {
      return (delta == 1
          && !exists(followEdge(followerId, followingId))
          && existsAfter(followEdge(followerId, followingId)))
        || (delta == -1
          && exists(followEdge(followerId, followingId))
          && !existsAfter(followEdge(followerId, followingId)));
    }

    function isFollowCounterStep(userId) {
      let followerDelta = request.resource.data.get('followerCount', 0)
        - resource.data.get('followerCount', 0);
      let followingDelta = request.resource.data.get('followingCount', 0)
        - resource.data.get('followingCount', 0);
      let targetId = request.resource.data.get('lastFollowTargetId', '');
      return request.resource.data.get('followerCount', 0) >= 0
        && request.resource.data.get('followingCount', 0) >= 0
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
            && followingDelta == 0
            && edgeTransitionMatches(followerDelta, request.auth.uid, userId))
          ||
          (request.auth.uid == userId
            && targetId is string
            && targetId.size() > 0
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['followingCount', 'lastFollowTargetId'])
            && followerDelta == 0
            && edgeTransitionMatches(followingDelta, userId, targetId))
        );
    }

    // Diary logs — the source of the Community feed. A log is world-readable
    // only when its owner explicitly marked it isPublic == true; otherwise
    // only the owner can read it. starredBy/commentCount are updated by
    // *other* users (liking/commenting), so those two fields are allowed to
    // change even when the request isn't from the owner — everything else
    // stays owner-only.
    match /logs/{logId} {
      allow read: if resource.data.isPublic == true
                   || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null
        && authorFieldsAreOwn()
        && socialCountersStartEmpty()
        && withinTextLimits();
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.userId
          && withinTextLimits()
          && authorAndSocialFieldsAreUnchanged()) ||
        isOwnStarToggle() ||
        isCommentCountStep('logs', logId)
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/logs/$(logId)).data.isPublic == true ||
                     (request.auth != null &&
                      request.auth.uid == get(/databases/$(database)/documents/logs/$(logId)).data.userId);
        allow create: if request.auth != null
          && authorFieldsAreOwn()
          && request.resource.data.get('text', '').size() <= 1000
          && parentCounterMatchesComment('logs', logId, commentId, 1);
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.userId
          && parentCounterMatchesComment('logs', logId, commentId, -1);
        allow update: if false;
      }
    }

    // Community posts — every doc here was explicitly published via the
    // compose flow (share_compose_sheet.dart), so unlike `logs` there is no
    // isPublic branch: existence itself means "world-readable". starredBy/
    // commentCount are updated by *other* users the same way logs' are.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && authorFieldsAreOwn()
        && socialCountersStartEmpty()
        && withinTextLimits();
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.userId
          && withinTextLimits()
          && authorAndSocialFieldsAreUnchanged()) ||
        isOwnStarToggle() ||
        isCommentCountStep('posts', postId)
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && authorFieldsAreOwn()
          && request.resource.data.get('text', '').size() <= 1000
          && parentCounterMatchesComment('posts', postId, commentId, 1);
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.userId
          && parentCounterMatchesComment('posts', postId, commentId, -1);
        allow update: if false;
      }
    }

    // Shared collections — the live-synced mirror behind 'collection'-type
    // community posts (see movie_repository.dart's setCollectionVisibility/
    // _mirrorSharedCollection). Doc id is "${ownerId}_${listId}". Unlike
    // `logs`/`posts`, existence of a doc here always means "currently
    // shared" — the owner deletes it outright to stop sharing, so there's
    // no isPublic branch to check.
    //
    // `ownerUsername`/`ownerAvatarUrl` are denormalised here for the same
    // reason as on posts, and were forgeable the same way — the collection
    // detail screen renders them verbatim.
    function collectionOwnerFieldsAreOwn() {
      return request.resource.data.ownerId == request.auth.uid
        && request.resource.data.get('ownerUsername', '') == ownProfile().get('username', '')
        && request.resource.data.get('ownerAvatarUrl', '') == ownProfile().get('avatarUrl', '')
        && request.resource.data.get('name', '').size() <= 100
        && request.resource.data.get('description', '').size() <= 500
        && request.resource.data.get('movies', []).size() <= 500;
    }

    match /shared_collections/{collectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && collectionOwnerFieldsAreOwn();
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerId
        && collectionOwnerFieldsAreOwn();
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // User profiles — readable by any SIGNED-IN user (username/avatar/follower
    // counts are shown on every profile screen and in user search), but only
    // the owner can write, except followerCount/followingCount which the
    // follow/unfollow batch on *another* user's account also needs to touch.
    //
    // This used to be `allow read: if true` so that signup could check whether
    // a username was free without being authenticated. That made every
    // document here world-readable — and the documents contained the user's
    // email address, so anyone could enumerate every account's email. Two
    // changes closed that: the email is no longer stored in this collection at
    // all (it lives in Firebase Auth, where only its owner can see it), and
    // username availability now goes through /usernames below, which is
    // claimed *after* the account is created and therefore never needs an
    // unauthenticated read.

    // The username a profile advertises must be one this account actually
    // holds in the /usernames registry below. Without this the registry was
    // advisory only: it is consulted by AuthController before writing, but
    // nothing stopped a client from calling the SDK directly and setting
    // `username` to a name someone else had claimed — which is the name shown
    // in user search, on the profile screen, and (via authorFieldsAreOwn)
    // stamped onto every post and comment. Impersonation was a one-line
    // script.
    //
    // Leaving the name untouched is always allowed, so avatar/bio/showcase
    // edits don't pay for a registry lookup.
    function usernameIsClaimedByOwner(userId) {
      return request.resource.data.username == resource.data.username
        || (request.resource.data.usernameLower == request.resource.data.username.lower()
            && exists(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower))
            && get(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == userId);
    }

    // Same lookup for the very first write, where there is no `resource` to
    // compare against yet.
    function usernameIsClaimedOnCreate(userId) {
      return request.resource.data.usernameLower == request.resource.data.username.lower()
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == userId;
    }

    function profileFieldsAreSane() {
      return request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 30
        && (request.resource.data.get('bio', null) == null
            || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 300))
        && isAllowedAvatar(request.resource.data.get('avatarUrl', 'https://api.dicebear.com/'))
        && request.resource.data.get('featuredMovieIds', []).size() <= 5
        && request.resource.data.get('shareSwipeTasteForMatching', false) is bool
        && request.resource.data.get('publicSwipeTasteGenreIds', []) is list
        && request.resource.data.get('publicSwipeTasteGenreIds', []).size() <= 3;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && usernameIsClaimedOnCreate(userId)
        && profileFieldsAreSane();
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && usernameIsClaimedByOwner(userId)
          && profileFieldsAreSane()
          && request.resource.data.get('followerCount', 0) == resource.data.get('followerCount', 0)
          && request.resource.data.get('followingCount', 0) == resource.data.get('followingCount', 0)) ||
        isFollowCounterStep(userId)
      );
      allow delete: if false;

      match /movie_settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // İlişki Ağı manual curation (added/removed/hidden people). Owner-only,
      // same as movie_settings.
      match /graph_overrides/{overrideId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Private inbox. Creation stays backend-only so a client cannot forge
      // events in another user's inbox.
      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow create: if false;
      }
    }

    // Username registry, doc id is the lowercased username, body is
    // { uid }. This collection exists purely to make usernames unique: a
    // claim is a document *create*, and Firestore only allows create when the
    // document does not already exist, so the uniqueness guarantee comes from
    // the server rather than from a client-side "is it free?" read that two
    // concurrent signups can both pass (see AuthController._claimUsername).
    //
    // Update is forbidden outright — a name is released by deleting the claim
    // and creating the new one in the same transaction, never by rewriting an
    // existing doc's uid, which would otherwise let someone hijack a claim.
    match /usernames/{usernameLower} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if false;
    }

    // Follow edges, doc id "${followerId}_${followingId}".
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.followerId
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && followId == request.resource.data.followerId + '_' + request.resource.data.followingId
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && getAfter(userProfile(request.resource.data.followerId)).data.followingCount
             == get(userProfile(request.resource.data.followerId)).data.followingCount + 1
        && getAfter(userProfile(request.resource.data.followerId)).data.lastFollowTargetId
             == request.resource.data.followingId
        && getAfter(userProfile(request.resource.data.followingId)).data.followerCount
             == get(userProfile(request.resource.data.followingId)).data.followerCount + 1;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.followerId
        && getAfter(userProfile(resource.data.followerId)).data.followingCount
             == get(userProfile(resource.data.followerId)).data.followingCount - 1
        && getAfter(userProfile(resource.data.followerId)).data.lastFollowTargetId
             == resource.data.followingId
        && getAfter(userProfile(resource.data.followingId)).data.followerCount
             == get(userProfile(resource.data.followingId)).data.followerCount - 1;
      allow update: if false;
    }
  }
}
