rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Social-interaction write guards (shared by `logs` and `posts`) ---
    //
    // Both collections let *other* users touch two fields — starredBy (like)
    // and commentCount — on a document they don't own. Restricting which
    // KEYS may change (hasOnly) is not enough on its own: it still let anyone
    // replace the whole starredBy array (wiping every other user's like, or
    // stuffing it with uids that never liked anything) or set commentCount to
    // an arbitrary number. These two functions pin down the allowed *shape* of
    // the change, not just its field names.
    //
    // `.get(field, default)` is used throughout because documents written
    // before these fields existed simply don't have them.

    // A like toggle may only add or remove the caller's own uid: the symmetric
    // difference between the old and new arrays must contain nothing else.
    function isOwnStarToggle() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starredBy'])
        && request.resource.data.get('starredBy', []).toSet()
             .difference(resource.data.get('starredBy', []).toSet())
             .hasOnly([request.auth.uid])
        && resource.data.get('starredBy', []).toSet()
             .difference(request.resource.data.get('starredBy', []).toSet())
             .hasOnly([request.auth.uid]);
    }

    // A comment add/remove moves the counter by exactly one, in step with the
    // matching write in the comments subcollection.
    function isCommentCountStep() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1);
    }

    // Following someone touches the *other* user's followerCount. Same
    // reasoning as isCommentCountStep: allow the counter to move by one, not
    // to be set to whatever the caller likes.
    function isFollowCounterStep() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['followerCount', 'followingCount'])
        && (request.resource.data.get('followerCount', 0) - resource.data.get('followerCount', 0)) >= -1
        && (request.resource.data.get('followerCount', 0) - resource.data.get('followerCount', 0)) <= 1
        && (request.resource.data.get('followingCount', 0) - resource.data.get('followingCount', 0)) >= -1
        && (request.resource.data.get('followingCount', 0) - resource.data.get('followingCount', 0)) <= 1;
    }

    // Diary logs — the source of the Community feed. A log is world-readable
    // only when its owner explicitly marked it isPublic == true; otherwise
    // only the owner can read it. starredBy/commentCount are updated by
    // *other* users (liking/commenting), so those two fields are allowed to
    // change even when the request isn't from the owner — everything else
    // stays owner-only.
    match /logs/{logId} {
      allow read: if resource.data.isPublic == true
                   || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isOwnStarToggle() ||
        isCommentCountStep()
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/logs/$(logId)).data.isPublic == true ||
                     (request.auth != null &&
                      request.auth.uid == get(/databases/$(database)/documents/logs/$(logId)).data.userId);
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
        allow update: if false;
      }
    }

    // Community posts — every doc here was explicitly published via the
    // compose flow (share_compose_sheet.dart), so unlike `logs` there is no
    // isPublic branch: existence itself means "world-readable". starredBy/
    // commentCount are updated by *other* users the same way logs' are.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isOwnStarToggle() ||
        isCommentCountStep()
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
        allow update: if false;
      }
    }

    // Shared collections — the live-synced mirror behind 'collection'-type
    // community posts (see movie_repository.dart's setCollectionVisibility/
    // _mirrorSharedCollection). Doc id is "${ownerId}_${listId}". Unlike
    // `logs`/`posts`, existence of a doc here always means "currently
    // shared" — the owner deletes it outright to stop sharing, so there's
    // no isPublic branch to check.
    match /shared_collections/{collectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // User profiles — readable by any SIGNED-IN user (username/avatar/follower
    // counts are shown on every profile screen and in user search), but only
    // the owner can write, except followerCount/followingCount which the
    // follow/unfollow batch on *another* user's account also needs to touch.
    //
    // This used to be `allow read: if true` so that signup could check whether
    // a username was free without being authenticated. That made every
    // document here world-readable — and the documents contained the user's
    // email address, so anyone could enumerate every account's email. Two
    // changes closed that: the email is no longer stored in this collection at
    // all (it lives in Firebase Auth, where only its owner can see it), and
    // username availability now goes through /usernames below, which is
    // claimed *after* the account is created and therefore never needs an
    // unauthenticated read.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        isFollowCounterStep()
      );
      allow delete: if false;

      match /movie_settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // İlişki Ağı manual curation (added/removed/hidden people). Owner-only,
      // same as movie_settings.
      match /graph_overrides/{overrideId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Username registry, doc id is the lowercased username, body is
    // { uid }. This collection exists purely to make usernames unique: a
    // claim is a document *create*, and Firestore only allows create when the
    // document does not already exist, so the uniqueness guarantee comes from
    // the server rather than from a client-side "is it free?" read that two
    // concurrent signups can both pass (see AuthController._claimUsername).
    //
    // Update is forbidden outright — a name is released by deleting the claim
    // and creating the new one in the same transaction, never by rewriting an
    // existing doc's uid, which would otherwise let someone hijack a claim.
    match /usernames/{usernameLower} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if false;
    }

    // Follow edges, doc id "${followerId}_${followingId}".
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
      allow update: if false;
    }
  }
}
